# Copy to .env. Keep this file private; never commit actual credentials.
# PostgreSQL Windows: use Windows host IP with WSL NAT, or localhost with mirrored networking.
DATABASE_URL=
# Example: postgresql+psycopg://video_clipping:PASSWORD@WINDOWS_HOST:5432/video_clipping
REDIS_URL=
WHISPER_MODEL=
WHISPER_THREADS=

# Gemini credentials: manage in Settings or root apikey.json (see apikey.json.example).
# Export delivery: global (default) or local; local requires an existing absolute folder.
EXPORT_MODE=
EXPORT_LOCAL_DIR=
