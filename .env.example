# KONFIGURASI VIDEO CLIPPING
# Setiap key diberi keterangan fungsi, satuan, dan nilai default.
# .env berisi konfigurasi aktual; .env.example adalah contoh tanpa kredensial asli.
# Setelah mengubah konfigurasi, restart backend dan worker agar konsisten.
# Pengaturan backend utama yang tidak diisi/kosong memakai default aplikasi.
# DATABASE_URL serta 9router_base_url dan 9router_key tetap perlu diisi.
# Pengaturan gaya video dan preferensi workspace disimpan melalui aplikasi.

# --- KONEKSI DATABASE DAN ANTREAN ---
# URL koneksi database PostgreSQL. Wajib diisi sesuai database yang digunakan.
# Tidak memiliki default yang dapat langsung dipakai; dapat mengandung password.
DATABASE_URL=

# Alamat Redis untuk antrean pekerjaan backend dan worker.
# Default: redis://127.0.0.1:6381/0. Sesuaikan host, port, dan nomor database bila perlu.
REDIS_URL=redis://127.0.0.1:6381/0

# --- LAYANAN AI 9ROUTER ---
# Alamat API 9Router, wajib berupa URL HTTP/HTTPS yang diakhiri /v1.
# Tidak memiliki default; gunakan alamat yang dapat dijangkau backend.
9router_base_url=

# API key untuk autentikasi ke 9Router. Wajib diisi dengan key yang aktif.
# Rahasia: jangan salin nilai asli ke .env.example atau masukkan ke Git.
9router_key=

# --- TRANSKRIPSI WHISPER LOKAL ---
# Profil model transkripsi. Default: standard.
# standard = Whisper small (lebih akurat, lebih berat).
# light = Whisper base (lebih ringan). Ganti profil ini untuk memilih model.
WHISPER_PROFILE=standard

# Pengaturan kompatibilitas lama. Default: small; pilihan: small atau base.
# Hanya dibaca ketika WHISPER_PROFILE tidak diisi. Jika profil diisi, profil yang berlaku.
WHISPER_MODEL=small

# Jumlah thread CPU untuk transkripsi Whisper. Default: 2 thread.
# Semakin banyak thread dapat menambah beban CPU; sesuaikan dengan kemampuan mesin.
WHISPER_THREADS=2

# --- PENERIMAAN VIDEO SUMBER PROYEK ---
# Durasi minimum video sumber yang diterima untuk analisis, dalam detik.
# Default: 10 detik. Sistem tetap menerapkan batas bawah efektif 10 detik.
# Gunakan 10 sampai 18000; batas maksimum sumber tetap 5 jam dan tidak diatur oleh key ini.
SOURCE_MIN_DURATION_SECONDS=10

# --- BATAS VIDEO KOLEKSI / SISIPAN ---
# Ukuran maksimum satu file video yang diunggah ke koleksi.
# Default: 200 MB; perhitungan backend memakai 1 MB = 1024 x 1024 byte.
LIBRARY_MAX_MB=200

# Durasi maksimum satu video koleksi, dalam detik.
# Default: 1800 detik = 30 menit. Ini bukan batas durasi highlight atau video sumber proyek.
LIBRARY_MAX_DURATION=1800

# --- HASIL EKSPOR VIDEO ---
# Cara menerima hasil ekspor. Default: global.
# global = hasil diunduh melalui browser; local = hasil disalin ke folder EXPORT_LOCAL_DIR.
EXPORT_MODE=global

# Folder tujuan ekspor ketika EXPORT_MODE=local; default kosong.
# Gunakan path absolut ke folder yang sudah ada dan dapat ditulis backend/worker.
# Boleh kosong ketika EXPORT_MODE=global. Path Windows didukung pada Windows/WSL.
EXPORT_LOCAL_DIR=
