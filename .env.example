# Copy to .env. Keep this file private; never commit actual credentials.
# PostgreSQL Windows: use Windows host IP with WSL NAT, or localhost with mirrored networking.
DATABASE_URL=
# Example: postgresql+psycopg://video_clipping:PASSWORD@WINDOWS_HOST:5432/video_clipping
GEMINI_API_KEY=
REDIS_URL=redis://127.0.0.1:6381/0
WHISPER_MODEL=base
WHISPER_THREADS=2
